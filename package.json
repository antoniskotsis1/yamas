{
  "name": "yamas-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "YAMAS — Greek street food, Warsaw. Vite + React + TypeScript, pre-rendered in PL/EN/EL.",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/commissioner": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-imagetools": "^7",
    "vitest": "^2"
  }
}
